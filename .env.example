# CineAI Backend Configuration
# Copy this file to .env and fill in your API keys

# Groq API (for LLM story generation - Phase 1)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs API (for TTS audio generation - Phase 2)
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Hugging Face API (for image generation - Phase 3)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS (allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
